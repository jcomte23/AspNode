<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - AspNode.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/dist/main.css" />
</head>
<body class="min-h-full flex flex-col bg-slate-50 text-slate-800 antialiased">
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
        <a class="flex items-center gap-2 text-lg font-semibold tracking-tight text-slate-900" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">AN</span>
            AspNode
        </a>

        <button id="nav-toggle" type="button" class="rounded-md p-2 text-slate-600 hover:bg-slate-100 sm:hidden" aria-controls="nav-menu" aria-expanded="false" aria-label="Abrir menú">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>

        <ul id="nav-menu" class="hidden absolute inset-x-0 top-full flex-col gap-1 border-b border-slate-200 bg-white p-4 sm:static sm:flex sm:flex-row sm:items-center sm:gap-1 sm:border-0 sm:bg-transparent sm:p-0">
            <li><a class="block rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li><a class="block rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a></li>
            <li class="sm:ml-2"><a class="block rounded-md bg-indigo-600 px-4 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" href="https://learn.microsoft.com/aspnet/core" target="_blank" rel="noopener">Documentación</a></li>
        </ul>
    </nav>
</header>

<main role="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6">
    @RenderBody()
</main>

<footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-6 text-sm text-slate-500 sm:flex-row sm:px-6">
        <span>&copy; 2026 AspNode.Web</span>
        <a class="hover:text-slate-900" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
    </div>
</footer>
<script type="module" src="~/dist/main.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
