@{
    ViewData["Title"] = "Política de privacidad";
}

<div class="mx-auto max-w-3xl">
    <span class="text-sm font-medium uppercase tracking-wider text-indigo-600">Legal</span>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">@ViewData["Title"]</h1>
    <p class="mt-3 text-slate-600">Última actualización: septiembre de 2026</p>

    <div class="mt-8 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <section>
            <h2 class="text-lg font-semibold text-slate-900">1. Información que recopilamos</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Usa esta página para detallar qué datos recoge tu aplicación, con qué finalidad y durante cuánto tiempo se conservan.</p>
        </section>
        <section>
            <h2 class="text-lg font-semibold text-slate-900">2. Uso de cookies</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Describe las cookies que utiliza el sitio (sesión, analítica, preferencias) y cómo el usuario puede gestionarlas.</p>
        </section>
        <section>
            <h2 class="text-lg font-semibold text-slate-900">3. Contacto</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Indica un medio de contacto para consultas relacionadas con la privacidad y el ejercicio de derechos.</p>
        </section>
    </div>
</div>
